{
  "name": "meepleverse-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @meepleverse/contracts build && tsx watch src/index.ts",
    "build": "pnpm --filter @meepleverse/contracts build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "pnpm --filter @meepleverse/contracts build && tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "pnpm --filter @meepleverse/contracts build && vitest run",
    "test:watch": "pnpm --filter @meepleverse/contracts build && vitest",
    "test:browser-server": "pnpm --filter @meepleverse/contracts build && tsx tests/browser/server.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.28",
    "@colyseus/schema": "5.0.48",
    "@colyseus/ws-transport": "0.18.5",
    "@meepleverse/contracts": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "5.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.10",
    "@meepleverse/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "vitest": "^5.1.0"
  }
}

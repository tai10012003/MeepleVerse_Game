{
  "name": "meepleverse-game",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npx --yes pnpm@10.34.9 --parallel --filter \"./apps/*\" dev",
    "dev:user": "npx --yes pnpm@10.34.9 --filter meepleverse-user-web dev",
    "dev:admin": "npx --yes pnpm@10.34.9 --filter meepleverse-admin-portal dev",
    "dev:api": "npx --yes pnpm@10.34.9 --filter meepleverse-api dev",
    "dev:api:expanded": "npx --yes pnpm@10.34.9 --filter meepleverse-api dev:expanded",
    "typecheck": "npx --yes pnpm@10.34.9 -r --if-present typecheck",
    "lint": "npx --yes pnpm@10.34.9 -r --if-present lint",
    "build": "npx --yes pnpm@10.34.9 -r --if-present build",
    "test": "npx --yes pnpm@10.34.9 --filter meepleverse-api test"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "eslint": "9.39.5",
    "typescript-eslint": "^8.46.0"
  }
}
